       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Example - Imaging Study Manifest (DICOM KOS)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Example DocumentReference for a DICOM KOS-encoded imaging study manifest.\n\nThis is one half of the dual-DocumentReference pattern for imaging manifests.\nThe DICOM KOS DocumentReference is linked to its FHIR manifest counterpart\nvia `relatesTo.code = transforms`." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
