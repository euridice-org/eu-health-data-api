       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Example - Imaging Report DocumentReference" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Example DocumentReference for a diagnostic imaging report.\n\n**Example query:**\n```\nGET [base]/DocumentReference?patient.identifier=http://example.org/national-id|123456789&type=http://loinc.org|85430-7\n```" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
