  fhir:CapabilityStatement.name [ fhir:value "DocumentPublisherEuApi"] ;
  fhir:CapabilityStatement.title [ fhir:value "EEHRxF Document Publisher CapabilityStatement"] ;
  fhir:CapabilityStatement.status [ fhir:value "active"] ;
  fhir:CapabilityStatement.experimental [ fhir:value "false"^^xsd:boolean] ;
  fhir:CapabilityStatement.date [ fhir:value "2026-01-26"^^xsd:date] ;
  fhir:CapabilityStatement.publisher [ fhir:value "HL7 Europe"] ;
  fhir:CapabilityStatement.contact [
     fhir:index -1 ;
     fhir:ContactDetail.name [ fhir:value "HL7 Europe" ] ;
     fhir:ContactDetail.telecom [
