      <documentation value="DocumentReference resources are served via ITI-67. The response uses base FHIR&#xA;DocumentReference resources without a required return profile."/>
      <interaction>
        <code value="read"/>
      </interaction>
      <interaction>
        <code value="search-type"/>
      </interaction>
      <searchParam>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
