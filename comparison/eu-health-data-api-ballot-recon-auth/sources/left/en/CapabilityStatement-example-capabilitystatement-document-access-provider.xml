  <rest>
    <mode value="server"/>
    <documentation value="This server provides document exchange for European Patient Summaries and&#xA;Laboratory Reports. It supports MHD ITI-67 (Find Document References),&#xA;ITI-68 (Retrieve Document), and PDQm ITI-78 (Patient Demographics Query)."/>
    <security>
      <service>
        <coding>
          <system value="http://hl7.org/fhir/restful-security-service"/>
          <code value="SMART-on-FHIR"/>
        </coding>
      </service>
      <description value="SMART Backend Services authorization required."/>
    </security>
    <resource>
