     fhir:CodeSystem.concept.definition [ fhir:value "Electronic health data related to the use of or produced by technologies that are used to view the human body in order to prevent, diagnose, monitor or treat medical conditions." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "Laboratory-Reports" ] ;
