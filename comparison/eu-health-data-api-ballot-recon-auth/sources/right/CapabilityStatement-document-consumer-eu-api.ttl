  ] ;
  fhir:CapabilityStatement.rest [
     fhir:index 0 ;
     fhir:CapabilityStatement.rest.mode [ fhir:value "client" ] ;
     fhir:CapabilityStatement.rest.documentation [ fhir:value "The Document Consumer actor queries for document metadata and retrieves documents\nfrom a Document Access Provider. It also queries for patient context using PDQm.\nIt groups with the IUA Authorization Client, SMART App, or SMART Backend Service selected by the\nenvironment and use case. The Authorization Server is a separate participant; see\n[Authorization](authorization.html#environment-specific-requirements)." ] ;
     fhir:CapabilityStatement.rest.security [
       fhir:CapabilityStatement.rest.security.description [ fhir:value "This abstract requirements statement does not advertise a fixed security service. A concrete\ndeployment SHALL declare exactly one security-service coding from the [EU Health Data API\nAuthorization Security Service ValueSet](ValueSet-eu-api-authorization-security-service.html),\nselected for its environment. It SHALL NOT advertise both services unless a future profile defines\ndual conformance.\n\n### IHE IUA\n\nThe consumer groups with the IUA Authorization Client and requests the applicable IUA MHD\ntransaction scopes for its supported transactions:\n- ITI-67\n- ITI-68\n\nPDQm ITI-78 has no IUA MHD transaction scope.\n\n### SMART Backend Services\n\nFor a pre-authorized system-to-system use case, the consumer groups with the SMART Backend Service,\nuses `client_credentials` and `private_key_jwt`, and requests:\n- system/DocumentReference.rs (read + search DocumentReference - ITI-67)\n- system/Binary.r (read Binary for document retrieval - ITI-68)\n- system/Bundle.r (read Bundle for FHIR Document retrieval - ITI-68)\n- system/Patient.rs (read + search Patient for context - ITI-78)\n\n### Interactive SMART\n\nWhere an interactive use case applies, the consumer groups with the SMART App, uses authorization\ncode with PKCE, and replaces the `system/` prefix above with the applicable `patient/` or `user/`\nscope prefix.\n\nAll modes use TLS 1.2 or higher. See [Authorization](authorization.html#smart-app-launch) for the\nselected capability set, discovery, token, and scope rules." ]
     ] ;
     fhir:CapabilityStatement.rest.resource [
       fhir:index 0 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation" ] ;
         fhir:Extension.valueCode [ fhir:value "SHALL" ]
       ] ;
       fhir:CapabilityStatement.rest.resource.type [ fhir:value "DocumentReference" ] ;
       fhir:CapabilityStatement.rest.resource.documentation [ fhir:value "DocumentReference resources are queried using ITI-67 and returned as base FHIR resources. No EU or MHD return profile is required." ] ;
       fhir:CapabilityStatement.rest.resource.interaction [
         fhir:index 0 ;
         fhir:Element.extension [
           fhir:index 0 ;
           fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation" ] ;
           fhir:Extension.valueCode [ fhir:value "SHALL" ]
         ] ;
         fhir:CapabilityStatement.rest.resource.interaction.code [ fhir:value "read" ] ;
         fhir:CapabilityStatement.rest.resource.interaction.documentation [ fhir:value "Read DocumentReference by logical ID" ]
       ], [
         fhir:index 1 ;
         fhir:Element.extension [
           fhir:index 0 ;
           fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation" ] ;
           fhir:Extension.valueCode [ fhir:value "SHALL" ]
         ] ;
         fhir:CapabilityStatement.rest.resource.interaction.code [ fhir:value "search-type" ] ;
         fhir:CapabilityStatement.rest.resource.interaction.documentation [ fhir:value "Search DocumentReference (ITI-67)" ]
       ] ;
       fhir:CapabilityStatement.rest.resource.searchParam [
         fhir:index 0 ;
         fhir:Element.extension [
           fhir:index 0 ;
           fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation" ] ;
           fhir:Extension.valueCode [ fhir:value "SHALL" ]
         ] ;
         fhir:CapabilityStatement.rest.resource.searchParam.name [ fhir:value "_id" ] ;
         fhir:CapabilityStatement.rest.resource.searchParam.definition [
           fhir:value "http://hl7.org/fhir/SearchParameter/Resource-id" ;
           fhir:link <http://hl7.org/fhir/SearchParameter/Resource-id>
         ] ;
         fhir:CapabilityStatement.rest.resource.searchParam.type [ fhir:value "token" ] ;
         fhir:CapabilityStatement.rest.resource.searchParam.documentation [ fhir:value "Logical id" ]
       ], [
         fhir:index 1 ;
         fhir:Element.extension [
           fhir:index 0 ;
           fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation" ] ;
           fhir:Extension.valueCode [ fhir:value "MAY" ]
         ] ;
         fhir:CapabilityStatement.rest.resource.searchParam.name [ fhir:value "_lastUpdated" ] ;
         fhir:CapabilityStatement.rest.resource.searchParam.definition [
           fhir:value "http://hl7.org/fhir/SearchParameter/Resource-lastUpdated" ;
