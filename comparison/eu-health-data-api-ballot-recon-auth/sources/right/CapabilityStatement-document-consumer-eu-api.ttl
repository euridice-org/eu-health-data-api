     ]
  ] ;
  fhir:CapabilityStatement.copyright [ fhir:value "Copyright HL7 Europe. Licensed under Creative Commons public domain (CC0 1.0)."] ;
  fhir:CapabilityStatement.kind [ fhir:value "requirements"] ;
