       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Example - Laboratory Report DocumentReference" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Example DocumentReference for a laboratory report.\n\n**Example query:**\n```\nGET [base]/DocumentReference?patient.identifier=http://example.org/national-id|123456789&type=http://loinc.org|11502-2\n```" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "CapabilityStatement" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/CapabilityStatement/example-capabilitystatement-document-access-provider> ;
         fhir:Reference.reference [ fhir:value "CapabilityStatement/example-capabilitystatement-document-access-provider" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Example: Document Access Provider Supporting EPS and Laboratory" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "**Example** CapabilityStatement for a Document Access Provider that supports\nEuropean Patient Summaries and Laboratory Reports.\n\nShows how a deployment declares actor conformance via `instantiates` and\ncontent IG support via `implementationGuide`. This concrete deployment selects\nSMART Backend Services and therefore advertises only `SMART-on-FHIR`.\n\nSee [Capability Discovery](capability-discovery.html) for guidance." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/ActorDefinition/eu-authorization-client-eu-api> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/eu-authorization-client-eu-api" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Health Data API Authorization Client" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The Health Data API Authorization Client obtains an access token from the selected Authorization Server\nand presents it to a protected API. Client authentication, grants, scopes, discovery, and\nlaunch context depend on the selected environment and protocol; public SMART interactive\nclients do not authenticate at the token endpoint. This generic role does not by itself\nclaim IHE IUA or SMART conformance. See the applicable [IHE IUA Authorization Client](https://profiles.ihe.net/ITI/IUA/index.html#34111-authorization-client),\n[SMART App](ActorDefinition-smart-app-eu-api.html), or [SMART Backend Service](ActorDefinition-smart-backend-service-eu-api.html)\ndefinition and the relevant [Authorization](authorization.html) requirements." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/ActorDefinition/eu-authorization-server-eu-api> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/eu-authorization-server-eu-api" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Health Data API Authorization Server" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The Health Data API Authorization Server issues access tokens after applying the authentication and\nauthorization requirements of the selected environment and protocol. When user authentication\nis required, it relies on an acceptable result from the\n[Authentication Service](ActorDefinition-authentication-service-eu-api.html), with which it MAY\nbe grouped. Authentication alone does not establish API access entitlement. Client assertion\nvalidation applies only when the selected flow uses asymmetric client authentication. The\nAuthorization Server remains responsibility-distinct from a Resource Server, including when\nthe two are co-located. This generic role does not by itself claim IHE IUA or SMART conformance.\nThe Health Data API qualifier identifies this IG's role, not a central EU-operated service.\nSee the applicable [IHE IUA Authorization Server](https://profiles.ihe.net/ITI/IUA/index.html#34112-authorization-server)\nor [SMART Authorization Server](ActorDefinition-smart-authorization-server-eu-api.html)\ndefinition and the relevant [Authorization](authorization.html) requirements." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/ActorDefinition/eu-authorization-resource-server-eu-api> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/eu-authorization-resource-server-eu-api" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Health Data API Resource Server" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The Health Data API Resource Server hosts a protected API, validates or introspects access\ntokens as applicable, and enforces granted authorization and local policy. It does not issue\naccess tokens or validate client assertions for an independent Authorization Server. This\ngeneric role does not by itself claim IHE IUA or SMART conformance. See the applicable\n[IHE IUA Resource Server](https://profiles.ihe.net/ITI/IUA/index.html#34113-resource-server)\nor [SMART FHIR Resource Server](ActorDefinition-smart-fhir-resource-server-eu-api.html)\ndefinition and the relevant [Authorization](authorization.html) requirements." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/ActorDefinition/iua-authorization-client-eu-api> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/iua-authorization-client-eu-api" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "IHE IUA Authorization Client" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The IHE IUA Authorization Client authenticates to the Authorization Server, requests\nleast-privilege scopes, and presents the resulting bearer token to the Resource Server.\nIt implements the applicable IUA transactions. See the\n[IHE IUA Authorization Client](https://profiles.ihe.net/ITI/IUA/index.html#34111-authorization-client)\nand [Authorization](authorization.html#ihe-iua)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/ActorDefinition/iua-authorization-server-eu-api> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/iua-authorization-server-eu-api" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "IHE IUA Authorization Server" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The independent IHE IUA Authorization Server authenticates clients, validates client\nassertions when selected, applies issuance policy, prevents replay, and issues tokens.\nWhere user authentication is required, it may use the IG-defined Authentication Service;\nthis does not remove any applicable IUA Authorization Server conformance obligation.\nIt does not provide protected-resource enforcement. See the\n[IHE IUA Authorization Server](https://profiles.ihe.net/ITI/IUA/index.html#34112-authorization-server)\nand [Authorization](authorization.html#ihe-iua).\nIUA requires this role to be grouped with a CT Time Client; see\n[required actor groupings](https://profiles.ihe.net/ITI/IUA/index.html#343-iua-required-actor-groupings)\nand the shared [Time Synchronization](authorization.html#time-synchronization) deployment guidance." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/ActorDefinition/iua-resource-server-eu-api> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/iua-resource-server-eu-api" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "IHE IUA Resource Server" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The IHE IUA Resource Server validates or introspects access tokens and enforces granted\nauthorization and local policy for protected resources. It does not validate client\nassertions for an independent Authorization Server. See the\n[IHE IUA Resource Server](https://profiles.ihe.net/ITI/IUA/index.html#34113-resource-server)\nand [Authorization](authorization.html#ihe-iua).\nIUA requires this role to be grouped with a CT Time Client; see\n[required actor groupings](https://profiles.ihe.net/ITI/IUA/index.html#343-iua-required-actor-groupings)\nand the shared [Time Synchronization](authorization.html#time-synchronization) deployment guidance." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/ActorDefinition/smart-app-eu-api> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/smart-app-eu-api" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SMART App" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The SMART App is an interactive client using authorization code and PKCE in standalone\nor EHR-launch mode. See [SMART App Launch](https://hl7.org/fhir/smart-app-launch/STU2.2/app-launch.html)\nand [Authorization](authorization.html#smart-app-launch)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/ActorDefinition/smart-authorization-server-eu-api> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/smart-authorization-server-eu-api" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SMART Authorization Server" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The SMART Authorization Server authenticates clients as applicable, authorizes requests,\nand issues tokens. It remains a distinct participant from the protected FHIR Resource Server.\nFor interactive flows it may rely on the IG-defined Authentication Service for user\nauthentication without transferring its SMART conformance obligations. Backend Services does\nnot require runtime end-user authentication.\nSee [SMART App Launch](https://hl7.org/fhir/smart-app-launch/STU2.2/)\nand [Authorization](authorization.html#smart-app-launch). This IG recommends CT Time Client grouping\nfor this server role in both interactive and Backend Services modes; see\n[SMART Server Time Synchronization](authorization.html#smart-server-time-synchronization)\nand the shared [Time Synchronization](authorization.html#time-synchronization) deployment guidance." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/ActorDefinition/smart-backend-service-eu-api> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/smart-backend-service-eu-api" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SMART Backend Service" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The SMART Backend Service is a pre-authorized confidential server-side client using\nclient credentials, asymmetric client authentication, and applicable system scopes.\nSee [SMART Backend Services](https://hl7.org/fhir/smart-app-launch/STU2.2/backend-services.html)\nand [Authorization](authorization.html#smart-app-launch)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/ActorDefinition/smart-fhir-resource-server-eu-api> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/smart-fhir-resource-server-eu-api" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SMART FHIR Resource Server" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The SMART FHIR Resource Server hosts protected FHIR resources, validates access tokens,\nand enforces granted SMART scopes. See [SMART App Launch](https://hl7.org/fhir/smart-app-launch/STU2.2/)\nand [Authorization](authorization.html#smart-app-launch). This IG recommends CT Time Client grouping\nfor this server role in both interactive and Backend Services modes; see\n[SMART Server Time Synchronization](authorization.html#smart-server-time-synchronization)\nand the shared [Time Synchronization](authorization.html#time-synchronization) deployment guidance." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/ActorDefinition/smart-launching-system-eu-api> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/smart-launching-system-eu-api" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SMART Launching System" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The SMART Launching System initiates an EHR launch and supplies the launch context for\nan interactive SMART App. See [SMART App Launch](https://hl7.org/fhir/smart-app-launch/STU2.2/app-launch.html)\nand [Authorization](authorization.html#smart-app-launch)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ] ;
