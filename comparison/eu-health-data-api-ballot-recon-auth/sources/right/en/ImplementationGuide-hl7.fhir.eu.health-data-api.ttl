     fhir:ImplementationGuide.definition.resource [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/ActorDefinition/authentication-service-eu-api> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/authentication-service-eu-api" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Authentication Service" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The Authentication Service authenticates an end user, directly or through a Wallet or upstream\nidentity provider, and supplies an authentication result trusted by the Health Data API Authorization Server.\nIt does not grant API access or issue API access tokens in this role. This IG-defined role is not\na formal IHE IUA or SMART actor. It MAY be grouped with the\n[Health Data API Authorization Server](ActorDefinition-eu-authorization-server-eu-api.html) in one implementation;\nthe interface between separate implementations is deployment-defined, not an interoperable\ntransaction specified by this IG. No ID token or token exchange is required by the actor split.\nSee [authentication and authorization groupings](actors.html#authentication-and-authorization-groupings)\nand [Authorization](authorization.html#authentication-and-api-authorization)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/ActorDefinition/document-access-provider-actor-eu-api> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/document-access-provider-actor-eu-api" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "EEHRxF Document Access Provider" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The Document Access Provider actor provides access to EEHRxF FHIR Documents by receiving\ndocuments from Document Publishers and serving them to Document Consumers. This composite\nactor groups MHD Document Recipient, MHD Document Responder, PDQm Patient Demographics\nSupplier, and the applicable IUA Resource Server or SMART FHIR Resource Server role.\nAn Authorization Server is independent; it may be co-located only as an optional deployment.\nSee [Authorization](authorization.html#environment-specific-requirements) for the selected role.\n\nSee [Document Access Provider CapabilityStatement](CapabilityStatement-document-access-provider-eu-api.html)\nfor technical requirements." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "CapabilityStatement" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.eu/fhir/health-data-api/CapabilityStatement/document-access-provider-submission-option-eu-api> ;
