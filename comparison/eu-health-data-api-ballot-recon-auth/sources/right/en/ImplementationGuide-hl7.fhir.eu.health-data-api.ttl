       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "EEHRxF Document Access Provider - Document Submission Option" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Requirements for the Document Submission Option on an EEHRxF Document Access Provider." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
