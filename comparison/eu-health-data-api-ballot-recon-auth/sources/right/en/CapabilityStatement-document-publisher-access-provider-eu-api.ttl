  ] ;
  fhir:CapabilityStatement.rest [
     fhir:index -1 ;
     fhir:CapabilityStatement.rest.mode [ fhir:value "server" ] ;
     fhir:CapabilityStatement.rest.documentation [ fhir:value "This grouped actor provides document access to external Document Consumers.\nDocument publication is internal and not exposed. The external API\nsupports document discovery (ITI-67), retrieval (ITI-68), and optional patient lookup (ITI-78).\n\nThe external endpoint groups with the Resource Server role selected by the environment and use case;\nsee [Authorization](authorization.html#environment-specific-requirements)." ] ;
     fhir:CapabilityStatement.rest.security [
       fhir:CapabilityStatement.rest.security.description [ fhir:value "This abstract requirements statement does not advertise a fixed security service. A concrete\ndeployment SHALL declare exactly one security-service coding from the [EU Health Data API\nAuthorization Security Service ValueSet](ValueSet-eu-api-authorization-security-service.html),\nselected for its environment. It SHALL NOT advertise both services unless a future profile defines\ndual conformance.\nThe Resource Server validates access tokens and granted authorization; the independent Authorization\nServer performs token issuance and any client-assertion validation.\n\n### IHE IUA\n\nThe external endpoint groups with the IUA Resource Server and enforces the IUA MHD transaction\nscopes `ITI-67` and `ITI-68`. PDQm ITI-78 has no IUA MHD transaction scope.\n\n### SMART Backend Services\n\nFor a pre-authorized system-to-system use case, the endpoint groups with the SMART FHIR Resource\nServer and accepts:\n- system/DocumentReference.rs (read + search DocumentReference - ITI-67)\n- system/Binary.r (read Binary - ITI-68)\n- system/Bundle.r (read Bundle - ITI-68 for FHIR Documents)\n- system/Patient.rs (read + search Patient - ITI-78)\n\n### Interactive SMART\n\nWhere an interactive use case applies, the endpoint groups with the SMART FHIR Resource Server and\nenforces the corresponding `patient/` or `user/` forms of the supported resource scopes.\n\nFor the IG-level CT grouping recommendation for SMART server roles, see\n[SMART Server Time Synchronization](authorization.html#smart-server-time-synchronization).\n\nAll modes use TLS 1.2 or higher. See\n[Authorization](authorization.html#tokens-scopes-enforcement-and-errors)." ]
     ] ;
     fhir:CapabilityStatement.rest.resource [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation" ] ;
         fhir:Extension.valueCode [ fhir:value "SHALL" ]
       ] ;
       fhir:CapabilityStatement.rest.resource.type [ fhir:value "DocumentReference" ] ;
       fhir:CapabilityStatement.rest.resource.documentation [ fhir:value "DocumentReference resources are returned as base FHIR resources. No EU or MHD return profile is required. Document creation is internal." ] ;
       fhir:CapabilityStatement.rest.resource.interaction [
         fhir:index -1 ;
         fhir:Element.extension [
           fhir:index -1 ;
           fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation" ] ;
           fhir:Extension.valueCode [ fhir:value "SHALL" ]
         ] ;
         fhir:CapabilityStatement.rest.resource.interaction.code [ fhir:value "read" ] ;
         fhir:CapabilityStatement.rest.resource.interaction.documentation [ fhir:value "Read DocumentReference by logical ID" ]
       ], [
         fhir:index -1 ;
         fhir:Element.extension [
           fhir:index -1 ;
           fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation" ] ;
           fhir:Extension.valueCode [ fhir:value "SHALL" ]
         ] ;
         fhir:CapabilityStatement.rest.resource.interaction.code [ fhir:value "search-type" ] ;
         fhir:CapabilityStatement.rest.resource.interaction.documentation [ fhir:value "Search for DocumentReference resources (ITI-67)" ]
       ] ;
       fhir:CapabilityStatement.rest.resource.updateCreate [ fhir:value "false"^^xsd:boolean ] ;
       fhir:CapabilityStatement.rest.resource.conditionalCreate [ fhir:value "false"^^xsd:boolean ] ;
       fhir:CapabilityStatement.rest.resource.conditionalUpdate [ fhir:value "false"^^xsd:boolean ] ;
       fhir:CapabilityStatement.rest.resource.conditionalDelete [ fhir:value "not-supported" ] ;
       fhir:CapabilityStatement.rest.resource.referencePolicy [
         fhir:value "resolves" ;
         fhir:index -1
       ] ;
       fhir:CapabilityStatement.rest.resource.searchRevInclude [
         fhir:value "Provenance:target" ;
         fhir:index -1
       ] ;
